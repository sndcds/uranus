CREATE INDEX idx_event_org_name_trgm ON uranus.event_projection USING GIN (org_name gin_trgm_ops);
CREATE INDEX idx_event_venue_name_trgm ON uranus.event_projection USING GIN (venue_name gin_trgm_ops);
CREATE INDEX idx_event_projection_search_vector ON uranus.event_projection USING GIN (search_vector tsvector_ops);

-- Triggers -------------------------------------------------------

CREATE TRIGGER set_modified_at
    BEFORE UPDATE ON uranus.event_projection
    FOR EACH ROW
